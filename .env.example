ENV=prod

# ===== Production credentials (ENV=prod) =====
PROD_SALES_BOT_TOKEN=your_sales_bot_token_here
PROD_COURSE_BOT_TOKEN=your_course_bot_token_here
PROD_ADMIN_BOT_TOKEN=your_admin_bot_token_here
PROD_ADMIN_CHAT_ID=your_admin_chat_id_here
PROD_GENERAL_GROUP_ID=your_general_group_id_here
PROD_PREMIUM_GROUP_ID=your_premium_group_id_here
PROD_GENERAL_GROUP_INVITE_LINK=https://t.me/+your_prod_general_invite
PROD_PREMIUM_GROUP_INVITE_LINK=https://t.me/+your_prod_premium_invite
PROD_DISCUSSION_GROUP_URL=https://t.me/+your_prod_discussion_invite
PROD_DATABASE_PATH=./data/prod/course_platform.db

# ===== Staging credentials (ENV=staging) =====
STG_SALES_BOT_TOKEN=your_staging_sales_bot_token_here
STG_COURSE_BOT_TOKEN=your_staging_course_bot_token_here
STG_ADMIN_BOT_TOKEN=your_staging_admin_bot_token_here
STG_ADMIN_CHAT_ID=your_staging_admin_chat_id_here
STG_GENERAL_GROUP_ID=your_staging_general_group_id_here
STG_PREMIUM_GROUP_ID=your_staging_premium_group_id_here
STG_GENERAL_GROUP_INVITE_LINK=https://t.me/+your_staging_general_invite
STG_PREMIUM_GROUP_INVITE_LINK=https://t.me/+your_staging_premium_invite
STG_DISCUSSION_GROUP_URL=https://t.me/+your_staging_discussion_invite
STG_DATABASE_PATH=./data/staging/course_platform.db

# ===== Common fallback values (used when prefixed vars are missing) =====
SALES_BOT_TOKEN=
COURSE_BOT_TOKEN=
ADMIN_BOT_TOKEN=
ADMIN_CHAT_ID=
GENERAL_GROUP_ID=
PREMIUM_GROUP_ID=
GENERAL_GROUP_INVITE_LINK=
PREMIUM_GROUP_INVITE_LINK=
DISCUSSION_GROUP_URL=
DATABASE_PATH=./data/course_platform.db

# Course settings shared by all environments
COURSE_DURATION_DAYS=30
LESSON_INTERVAL_HOURS=24

# Sales Bot: new linear flow (format -> program -> step -> plans -> payment).
# 0 or unset = old menu; 1 or true = new "Выберите формат" start screen.
SALES_NEW_FLOW=0
